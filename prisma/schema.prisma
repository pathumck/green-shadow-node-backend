// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Field {
  id       String @id
  name     String
  location String
  size     Int
  imageOne String @db.LongText
  imageTwo String @db.LongText

  logs       Log[]
  fieldCrops FieldCrop[]
  fieldStaff FieldStaff[]
}

model Crop {
  id             String @id
  commonName     String
  scientificName String
  category       String
  season         String
  image          String @db.LongText

  logs       Log[]
  fieldCrops FieldCrop[]
}

model Staff {
  id          String @id
  registerDate String
  firstName   String
  lastName    String
  birthDay    String
  gender      String
  phone       String
  email       String
  address     String
  designation String
  role        String

  fieldStaff FieldStaff[]
  vehicles   Vehicle[]
}

model Vehicle {
  id       String @id
  number   String @unique
  category String
  fuelType String
  remarks  String
  status   String
  staffId  String

  staff Staff @relation(fields: [staffId], references: [id], onDelete: Cascade)
}

model User {
  id       String @id
  username String @unique
  password String
  role     String 
  logs     Log[]
}

model Log {
  id          String @id
  date        String
  status      String
  description String
  image       String @db.LongText
  fieldId     String
  cropId      String
  userId      String

  field Field @relation(fields: [fieldId], references: [id], onDelete: Cascade)
  crop  Crop  @relation(fields: [cropId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model FieldCrop {
  fieldId String
  cropId  String

  field Field @relation(fields: [fieldId], references: [id], onDelete: Cascade)
  crop  Crop  @relation(fields: [cropId], references: [id], onDelete: Cascade)

  @@id([fieldId, cropId])
}

model FieldStaff {
  fieldId String
  staffId String

  field Field @relation(fields: [fieldId], references: [id], onDelete: Cascade)
  staff Staff @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@id([fieldId, staffId])
}
